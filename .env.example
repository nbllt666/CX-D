# DreamTalk LLM 配置（复制为 .env 后填写）
# 兼容 OpenAI 风格的 /chat/completions 接口

# 接口地址（默认 OpenAI；可换成任意兼容服务）
# Docker 中的 vLLM（宿主发布 8080）: http://127.0.0.1:8080/v1
# DreamTalk 也在同一 Docker 网络时:   http://llm:8080/v1
DREAMTALK_BASE_URL=https://api.openai.com/v1

# API Key。留空则自动进入 Mock 模式，可离线体验完整梦境对话
# Docker vLLM 默认不校验 Key，可填占位值 local
DREAMTALK_API_KEY=

# 默认模型；填 auto 时从 /v1/models 自动发现（适配 Docker vLLM）
DREAMTALK_MODEL=gpt-4o-mini

# 可选：为梦者 / 潜意识导演分别指定模型（留空则回退 DREAMTALK_MODEL）
DREAMTALK_DREAMER_MODEL=
DREAMTALK_DIRECTOR_MODEL=

# 强制 Mock（1/true/yes 生效）；即使配置了 Key 也不发起真实请求
DREAMTALK_MOCK=0

# 单场梦境最多轮数（每轮 = 导演 + 梦者各一段）
DREAMTALK_MAX_ROUNDS=8

# 每次请求携带的最近梦内回合数
DREAMTALK_CONTEXT_TURNS=16

# 自动模式权重（三者会被归一化）
DREAMTALK_MODE_WEIGHTS=memory=0.5,wild=0.3,dreamless=0.2

# 数据目录（存放 dreamtalk.db）
DREAMTALK_DATA_DIR=data

# 服务监听地址
DREAMTALK_HOST=127.0.0.1
DREAMTALK_PORT=8000

# LLM 请求超时（秒）
DREAMTALK_TIMEOUT=60

# 是否读取系统代理：auto/留空 = 本地和内网地址自动绕过代理，公网服务走系统代理
# 如遇 localhost 的 Docker LLM 返回 502，可显式设为 0
DREAMTALK_TRUST_ENV=auto
